# ====== Django ======
# 本番では `python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"` で生成
DJANGO_SECRET_KEY=django-insecure-dev-only-change-me-in-production
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# ====== PostgreSQL ======
POSTGRES_DB=shortcuts
POSTGRES_USER=myuser
POSTGRES_PASSWORD=mypassword
POSTGRES_HOST=db
POSTGRES_PORT=5432

# ====== CORS ======
# カンマ区切りで本番ドメインを追加
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ====== Redis ======
# DRF Throttle のカウンタを共有するためのキャッシュ。docker-compose の
# redis サービスに合わせている。本番では ElastiCache 等の URL に差し替える。
REDIS_URL=redis://localhost:6379/0

# ====== Frontend ======
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
