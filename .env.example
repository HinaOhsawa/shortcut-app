# ====== Django ======
# 本番では `python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"` で生成
DJANGO_SECRET_KEY=django-insecure-dev-only-change-me-in-production
DJANGO_DEBUG=True
# Docker 構成では Next.js が Host: backend:8000 で内部プロキシするため backend も含める
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend

# ====== PostgreSQL ======
POSTGRES_DB=shortcuts
POSTGRES_USER=myuser
POSTGRES_PASSWORD=mypassword
POSTGRES_HOST=db
POSTGRES_PORT=5432

# ====== CORS ======
# カンマ区切りで本番ドメインを追加
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ====== Frontend ======
# 同一オリジン化により API はブラウザから相対パス /api/* で叩く。
# Next.js サーバ → Django のプロキシ先（クライアントに露出しない）。
# Docker は docker-compose.yml が backend サービス名を上書き設定する。
BACKEND_INTERNAL_URL=http://localhost:8000
